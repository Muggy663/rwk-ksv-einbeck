        "km_disziplinen": "Disziplinen mit Kennziffern",
        "km_meldungen_[saison]": "KM-Meldungen pro Saison"
      }
    },

    "kennziffer_system": {
      "format": "XYYYYZZZ (8 Ziffern)",
      "aufbau": {
        "X": "Entfernung (1=10m, 2=15m, 3=25m, 4=50m)",
        "YYYY": "DSB-Regelnummer (0110=LG, 0210=LP, 0120=3-Stellung, 0111=LG Auflage)",
        "ZZZ": "Schussanzahl (020=20, 040=40, 060=60)"
      },
      "beispiele": {
        "10110020": "LG Schüler (20 Schuss)",
        "10110040": "LG Erwachsene (40 Schuss)", 
        "10111020": "LG Auflage Schüler (20 Schuss)",
        "10111040": "LG Auflage Erwachsene (40 Schuss)",
        "10210020": "LP Schüler (20 Schuss)",
        "10210040": "LP Erwachsene (40 Schuss)",
        "10120060": "3-Stellung (60 Schuss)"
      },
      "altersklassen_zuordnung": {
        "schueler": "≤14 Jahre → 20 Schuss",
        "jugend": "≤16 Jahre → 20 Schuss", 
        "junioren": "≤18 Jahre → 40 Schuss",
        "erwachsene": ">18 Jahre → 40 Schuss"
      }
    },

