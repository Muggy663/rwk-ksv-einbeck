    "workflows": {
      "startlisten_erstellen": {
        "schritte": [
          "1. /km-orga/startlisten - Austragungsort konfigurieren",
          "2. /startlisten-tool?id=[CONFIG_ID] - Tool öffnen",
          "3. Saison auswählen - Meldungen werden geladen",
          "4. 'Startliste generieren' oder 'Einfache Liste' klicken",
          "5. Schützen manuell hinzufügen falls nötig (Terminwechsel)",
          "6. Stände und Startzeiten anpassen",
          "7. 'Speichern' - Startliste wird in Firebase gespeichert",
          "8. PDF-Export oder Meyton-Export für Wettkampf"
        ]
      },
      
      "terminwechsel_feature": {
        "beschreibung": "Schützen zwischen verschiedenen Wettkampfterminen verschieben",
        "schritte": [
          "1. Startlisten-Tool öffnen für gewünschten Termin",
          "2. 'Schütze manuell hinzufügen' - Suchfeld verwenden",
          "3. Nach Name, Verein oder Disziplin suchen",
          "4. Schützen anklicken - wird automatisch hinzugefügt",
          "5. Schütze behält seine ursprüngliche Disziplin",
          "6. Hinweis: 'Terminwechsel - schießt am anderen Tag'"
        ],
        "anwendungsfall": "Freihand-Schütze kann nicht am Freihand-Tag → schießt am Auflage-Tag mit"
      },

      "david21_export": {
        "schritte": [
          "1. /km-orga/david21 öffnen",
          "2. Gespeicherte Startliste auswählen",
          "3. 'Startlisten exportieren' klicken",
          "4. .TXT und .CTL Dateien werden heruntergeladen",
          "5. Kennziffern werden automatisch aus Disziplinen-Verwaltung geholt",
          "6. Altersklassen-basierte Schusszahl-Auswahl",
          "7. Dateien in Meyton Shootmaster laden"
        ]
      }
    },

